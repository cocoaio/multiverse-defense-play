{
  "name": "多元防线",
  "short_name": "多元防线",
  "description": "跨越城市、雪原、医院与星球的竖屏 Roguelike 割草游戏",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "lang": "zh-CN",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#050b08",
